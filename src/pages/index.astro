---
// Stonework Risk — stoneworkrisk.com home page.
// Shared details (email, address, license, etc.) live in src/site.js.
// The page shell (head, nav, footer) lives in src/layouts/Base.astro.
// Styles live in src/styles/site.css.
import Base from "../layouts/Base.astro";
import {
  phone, phoneHref, tdiLicense, founded, email, linkedin, principalLinkedin, formAction, hours, address, siteUrl,
} from "../site.js";

// Who we serve — the client types the agency is built around.
const clients = [
  {
    title: "Auto dealers",
    body: "Garage liability, dealer open lot and inventory, and the fleet and workers' comp exposures that come with running a lot.",
  },
  {
    title: "Gaming & route operators",
    body: "Property, liability and crime coverage for game rooms, route operators and amusement businesses — a class many standard markets decline.",
  },
  {
    title: "Professional & financial firms",
    body: "Cyber, management liability and umbrella programs for law firms, wealth advisors and consultancies.",
  },
  {
    title: "Real estate & development",
    body: "Property, liability and excess programs for owners, developers and investors holding real assets.",
  },
  {
    title: "Technology companies",
    body: "Cyber, D&O and employment practices coverage for software and venture-backed teams as they scale.",
  },
  {
    title: "Private clients & families",
    body: "High-value homes, collector vehicles, boats and personal umbrella coordinated as one household program.",
  },
];

const coverage = [
  {
    group: "Commercial",
    lines: [
      "General Liability",
      "Commercial Property",
      "Commercial Auto & Fleet",
      "Workers' Compensation",
      "Umbrella & Excess",
      "Cyber Liability",
      "Management Liability — D&O, EPLI",
    ],
  },
  {
    group: "Personal & Private Client",
    lines: [
      "Homeowners & high-value residence",
      "Personal auto & collector vehicles",
      "Boat & yacht",
      "Personal umbrella",
      "Valuables, art & collections",
    ],
  },
];

const approach = [
  {
    num: "01",
    title: "Exposure review",
    body: "We start with how the business actually runs — operations, contracts, payroll, fleet, property — and find where the exposure really sits before anyone talks about premium.",
  },
  {
    num: "02",
    title: "Market access",
    body: "As an independent agency we place through national carriers and wholesale markets, so the structure follows the risk instead of whatever one carrier happens to sell.",
  },
  {
    num: "03",
    title: "Ongoing advocacy",
    body: "Renewals get worked ahead of the date rather than on it, and when a claim comes we handle the carrier side of it for you.",
  },
];

// Principal. Leave `photo` as "" to show the card without a picture;
// drop a headshot into public/ (e.g. public/kris-gardner.jpg) and set
// photo: "/kris-gardner.jpg" to add one.
const principal = {
  name:  "Kris Gardner",
  role:  "Founder & Principal",
  photo: "",
  bio: [
    "Kris founded Stonework Risk to bring an owner's perspective to the broker's side of the table. Alongside the agency, Kris builds and runs other operating companies, so the policies Stonework places are ones Kris has bought and renewed as a client.",
    "Every client works with Kris directly, from the first exposure review through each renewal.",
  ],
};

const schema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  name: "Stonework Risk",
  description:
    "Independent insurance and risk advisory in Dallas, Texas, serving entrepreneurs, business owners, and high-net-worth individuals.",
  url: siteUrl,
  logo: `${siteUrl}/stonework-wordmark-navy.png`,
  image: `${siteUrl}/stonework-og.png`,
  email,
  ...(phone ? { telephone: phone } : {}),
  ...(founded ? { foundingDate: founded } : {}),
  founder: { "@type": "Person", name: principal.name, jobTitle: principal.role, sameAs: [principalLinkedin] },
  address: {
    "@type": "PostalAddress",
    streetAddress: address.street,
    addressLocality: address.city,
    addressRegion: address.state,
    postalCode: address.zip,
    addressCountry: "US",
  },
  areaServed: { "@type": "State", name: "Texas" },
  openingHours: "Mo-Fr 08:00-17:00",
  sameAs: [linkedin],
};
---

<Base
  title="Stonework Risk — Independent Insurance & Risk Advisory | Dallas, Texas"
  description="Stonework Risk is an independent insurance agency in Dallas, Texas. Commercial, personal, and private client coverage for entrepreneurs, business owners, and high-net-worth individuals."
  schema={schema}
>
  <main id="top" class="wrap">
    <p class="eyebrow">Independent Insurance &amp; Risk Advisory · Dallas, Texas</p>

    <div class="mark">
      <img class="logo" src="/stonework-wordmark.svg" width="1294" height="386" alt="Stonework Risk" />
    </div>

    <div class="rule"></div>

    <h1 class="headline">Built for those who build.</h1>

    <p class="lede">
      The best advisors know what it means to build. Stonework Risk serves
      entrepreneurs, business owners, and high-net-worth individuals whose risk
      profiles are as considered as their ambitions.
    </p>
    <p class="lede">
      As an independent agency, our only allegiance is to the right solution. We
      access a broad market to find coverage built around your needs, and we
      advocate on your behalf when it matters most.
    </p>

    <div class="hero-actions">
      <a class="btn-ghost" href="#contact">Request a consultation</a>
      {phone && <a class="call-link" href={`tel:${phoneHref}`}>or call {phone}</a>}
    </div>
  </main>

  <section id="clients">
    <p class="section-label">Who we serve</p>
    <h2 class="section-title">The clients we are built for</h2>
    <div class="serve-grid">
      {clients.map((c) => (
        <div class="serve">
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="coverage">
    <p class="section-label">Coverage</p>
    <h2 class="section-title">What we place</h2>
    <div class="cov-grid">
      {coverage.map((g) => (
        <div class="cov-group">
          <h3>{g.group}</h3>
          <ul>
            {g.lines.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="approach">
    <p class="section-label">Approach</p>
    <h2 class="section-title">How an engagement works</h2>
    <div class="steps">
      {approach.map((s) => (
        <div class="step">
          <span class="num">{s.num}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="about">
    <p class="section-label">About</p>
    <h2 class="section-title">An operator's agency</h2>
    <div class="about">
      <p>
        Stonework Risk is an independent insurance agency in Dallas, run by operators.
        We have bought these policies as clients before placing them as brokers, and we
        read a schedule of coverage the way an owner does — looking for what happens on
        the worst day.
      </p>
      <p>
        Independent means no quota and no house carrier. We are paid to place the
        right structure, which includes telling you when your current program is
        already the right one.
      </p>
    </div>

    <div class="principal">
      {principal.photo && (
        <img class="principal-photo" src={principal.photo} alt={principal.name} width="264" height="320" />
      )}
      <div>
        <p class="role">{principal.role}</p>
        <h3>{principal.name}</h3>
        {principal.bio.map((p) => <p class="bio">{p}</p>)}
        <p class="links"><a href={principalLinkedin} target="_blank" rel="noopener">LinkedIn</a></p>
      </div>
    </div>
  </section>

  <section id="contact">
    <p class="section-label">Contact</p>
    <h2 class="section-title">Start a conversation</h2>
    <div class="contact-grid">
      <dl class="details">
        {phone && (
          <>
            <dt>Telephone</dt>
            <dd><a href={`tel:${phoneHref}`}>{phone}</a></dd>
          </>
        )}
        <dt>Email</dt>
        <dd><a href={`mailto:${email}`}>{email}</a></dd>

        <dt>Office</dt>
        <dd>
          {address.street}<br />
          {address.city}, {address.state} {address.zip}
        </dd>

        <dt>Hours</dt>
        <dd>{hours}</dd>

        {tdiLicense && (
          <>
            <dt>TDI Agency License</dt>
            <dd>{tdiLicense}</dd>
          </>
        )}
      </dl>

      <div class="cta">
        <p class="kicker">Tell us what you're building</p>
        <form id="inquiry" action={formAction} method="POST">
          <div class="field">
            <label class="sr-only" for="f-name">Name</label>
            <input id="f-name" type="text" name="name" placeholder="Name" autocomplete="name" />
          </div>
          <div class="field">
            <label class="sr-only" for="f-company">Company</label>
            <input id="f-company" type="text" name="company" placeholder="Company" autocomplete="organization" />
          </div>
          <div class="field">
            <label class="sr-only" for="f-email">Email (required)</label>
            <input id="f-email" type="email" name="email" placeholder="Email" autocomplete="email" required />
          </div>
          <div class="field">
            <label class="sr-only" for="f-phone">Phone (optional)</label>
            <input id="f-phone" type="tel" name="phone" placeholder="Phone (optional)" autocomplete="tel" />
          </div>
          <div class="field">
            <label class="sr-only" for="f-message">A note (optional)</label>
            <textarea id="f-message" name="message" placeholder="A note (optional)" rows="1"></textarea>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="f-gotcha">Leave this field empty</label>
            <input id="f-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="_subject" value="New inquiry — stoneworkrisk.com" />
          <button type="submit">Request a consultation</button>
          <p class="form-status" role="status" aria-live="polite"></p>
          <p class="form-note">
            By submitting, you agree to our <a href="/privacy">privacy policy</a>.
          </p>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    // Submit in the background and land on our own thank-you page instead of
    // Formspree's. Without JavaScript the form still posts normally.
    (function () {
      var form = document.getElementById("inquiry");
      if (!form || !window.fetch) return;
      var status = form.querySelector(".form-status");
      var button = form.querySelector("button[type=submit]");
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        button.disabled = true;
        status.className = "form-status";
        status.textContent = "Sending…";
        fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        })
          .then(function (res) {
            if (!res.ok) throw new Error("bad status");
            window.location.href = "/thanks";
          })
          .catch(function () {
            button.disabled = false;
            status.className = "form-status error";
            status.textContent =
              "Something went wrong sending your note. Please try again, or email principals@stoneworkrisk.com.";
          });
      });
    })();
  </script>
</Base>
